# Supabase — copy to .env.local and fill in values from:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set if dev server is not on port 3000 (e.g. http://localhost:3007)
# NEXT_PUBLIC_SITE_URL=http://localhost:3007

# --- Supabase Auth dashboard setup (required for OAuth / magic link) ---
#
# 1. Authentication → URL configuration
#    - Site URL (dev): http://localhost:3007  (match your npm run dev port)
#    - Redirect URLs (add every port you use locally):
#        http://localhost:3000/auth/callback
#        http://localhost:3005/auth/callback
#        http://localhost:3007/auth/callback
#        https://your-production-domain.com/auth/callback
#
# 2. Authentication → Providers — enable Google and paste Client ID + Secret
#
# 3. Google Cloud Console → OAuth client → Authorized redirect URIs
#    Add ONLY this (replace project ref from NEXT_PUBLIC_SUPABASE_URL):
#        https://your-project-ref.supabase.co/auth/v1/callback
#    Do NOT put http://localhost:... in Google — that causes redirect_uri_mismatch.
#    - Email: enable Email provider for magic-link sign-in
#
# The app uses Google OAuth and email magic links only.

# Fal — server-only secret from https://fal.ai/dashboard/keys (paste in .env.local only)
FAL_KEY=
